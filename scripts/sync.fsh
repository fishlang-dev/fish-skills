// Keeps the generated half of the knowledge pack in step with a fishc release.
//   fishc run scripts/sync.fsh -- report
//   fishc run scripts/sync.fsh -- pull [<tag>]
//
// `report` compares the release knowledge/VERSION names with the fishc on PATH and with the newest
// release tag of the compiler's source, and exits 1 when either differs. `pull` rewrites what is
// read straight from that source at a tag (its newest by default): knowledge/errors.md, every code
// with what `fishc explain` says of it; knowledge/std-api.md, every declaration std gives a
// program; examples/, the compiler's test programs; and knowledge/VERSION.
//
// The compiler's source is the checkout FISH_SRC names, else `fish` beside this repository. The
// hand-written slices are not touched: bringing them up to date is the sync skill's work.
import { spawnSyncText } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, readdirSync, realpathSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";

const ROOT = resolve(import.meta.dir, "..");
const USAGE = "usage: fishc run scripts/sync.fsh -- report | pull [<tag>]";

function fail(message: string): never {
  console.error(`sync: ${message}`);
  return process.exit(1);
}

// What a command printed, or a failure naming it.
function said(command: string, args: string[]): string {
  const shown = `${command} ${args.join(" ")}`;
  const r = spawnSyncText(command, args);
  if (r.status !== 0) fail(`'${shown}' failed:\n${r.stderr}`);
  return r.stdout;
}

function source(): string {
  const src = process.env.FISH_SRC ?? resolve(ROOT, "..", "fish");
  if (!existsSync(join(src, "src", "codes.fsh"))) fail(`no Fish compiler source at ${src}; set FISH_SRC to a checkout of fishlang-dev/fish`);
  return src;
}

function newestTag(src: string): string {
  const tags = said("git", ["-C", src, "tag", "--list", "v*", "--sort=-v:refname"]).trim().split("\n");
  if (tags[0]! === "") fail(`${src} has no release tags`);
  return tags[0]!;
}

// The release of the fishc on PATH, read from where its install keeps it, or "" when it isn't
// installed from a release.
function installed(): string throws IoError {
  const found = spawnSyncText("sh", ["-c", "command -v fishc"]).stdout.trim();
  if (found === "") return "";
  const at = realpathSync(found).match(/fishc-(\d+\.\d+\.\d+)-/);
  return at === null ? "" : at[1]!;
}

function errorsPage(src: string, tag: string): string {
  const table = said("git", ["-C", src, "show", `${tag}:src/codes.fsh`]);
  let out = `# Error and warning codes\n\nGenerated by scripts/sync.fsh from fishc ${tag}: each code with what \`fishc explain <code>\` prints.\nA code's first two digits give its area: 00 syntax, 01 types, 02 ownership, 03 async and threads,\n04 names, 05 calls and members, 06 control flow, 07 classes, interfaces and enums, 08 forms not\nsupported, 09 modules and manifests, 10 interop, 11 comptime, macros and tests.\n`;
  let codes = 0;
  for (const line of table.split("\n")) {
    const m = line.match(/^  ([EW]\d{4}): /);
    if (m === null) continue;
    const text = said("fishc", ["explain", m[1]!]).trim().split("\n");
    const body = text.slice(1).join("\n").trim();
    out += `\n## ${text[0]!}\n`;
    if (!body.startsWith("This code has no longer explanation yet")) out += `\n${body}\n`;
    codes++;
  }
  if (codes === 0) fail("no codes found in src/codes.fsh; has the table's layout changed?");
  return out;
}

// A declaration's line as a reader needs it: no `export`, and no body. A body opens at the first
// brace after the parameter list that isn't part of a type.
function signature(line: string): string {
  let s = line.trim();
  if (s.startsWith("export ")) s = s.slice(7);
  if (/^(abstract )?class /.test(s)) return s.slice(0, s.indexOf(" {") < 0 ? (s.length as i64) : s.indexOf(" {"));
  if (/^(type|const|interface|enum) /.test(s)) return s.endsWith("{") ? s.slice(0, (s.length as i64) - 1).trim() : s;
  let depth = 0;
  let closed = false;
  for (let i = 0; i < (s.length as i64); i++) {
    const c = s.slice(i, i + 1);
    if (c === "(") depth++;
    else if (c === ")") closed = --depth === 0 || closed;
    else if (c === "{" && closed && depth === 0 && !/[:|<,&]\s*$/.test(s.slice(0, i))) return s.slice(0, i).trim();
  }
  return s.endsWith("{") ? s.slice(0, (s.length as i64) - 1).trim() : s;
}

function stdPage(src: string, tag: string): string {
  const lines = said("git", ["-C", src, "show", `${tag}:src/std.fsh`]).split("\n");
  let out = `# Std API index\n\nGenerated by scripts/sync.fsh from fishc ${tag}: every declaration std gives a program, as its\nsource writes it. Search this file for a name before calling it; a name that isn't here and isn't\nin std.md does not exist. A module under "import" is reached as \`node:<name>\` or \`<name>\`, the\n\`fish:\` ones only by that name, and \`Bun\` as \`bun\`. Everything under "global" is in scope with\nno import.\n`;
  let chunk = "";
  let imported = false;
  let section = "";
  let inClass = false;
  let comment: string[] = [];
  let declarations = 0;
  for (const line of lines) {
    if (chunk === "") {
      const global = line.match(/^const ([A-Z_]+) = (String\.raw)?`$/);
      const module = line.match(/^  "?([\w:\/]+)"?: String\.raw`$/);
      // FILES is the one chunk no program sees as it stands: both fs modules splice it in.
      if (global !== null) chunk = global[1]! === "FILES" ? "import: fs and fs/promises (declarations both share)" : `global: ${global[1]!.toLowerCase()}`;
      else if (module !== null) chunk = `import: ${module[1]!}`;
      imported = module !== null;
      section = "";
      inClass = false;
      comment = [];
      continue;
    }
    if (line.startsWith("`")) {
      if (section !== "") out += `\n## ${chunk}\n\n${section}`;
      chunk = "";
      continue;
    }
    if (line.startsWith("//")) {
      comment.push(line);
      continue;
    }
    // A module gives what it exports; the globals are every declaration but std's own helpers,
    // whose names a program can't write.
    if (line.trim() === "") continue;
    const top = (imported ? /^export / : /^(export )?(abstract |async )*(function\*?|class|type|interface|enum|const) [A-Za-z]/).test(line) && !/^(export )?declare /.test(line);
    const member = inClass && /^  (static |async |get |set |readonly |\*)*[A-Za-z]\w*[?!]?(<[^(]*>)?[(:]/.test(line) && !/^  (private|protected) /.test(line);
    if (top) {
      inClass = /^(export )?(abstract )?class /.test(line);
      for (const c of comment) section += `${c}\n`;
      section += `${signature(line)}\n`;
      declarations++;
    } else if (member) section += `  ${signature(line)}\n`;
    else if (line === "}") inClass = false;
    else if (!line.startsWith(" ")) inClass = false;
    comment = [];
  }
  if (declarations < 100) fail(`only ${declarations} declarations found in src/std.fsh; has its layout changed?`);
  return out;
}

function pull(tag: string): void throws IoError {
  const src = source();
  const at = tag === "" ? newestTag(src) : tag;
  const commit = said("git", ["-C", src, "rev-parse", "--short", `${at}^{commit}`]).trim();
  const release = at.startsWith("v") ? at.slice(1) : at;
  const have = installed();
  if (have !== release) fail(`the fishc on PATH is ${have === "" ? "not a release install" : have}, and ${at} is being pulled; install that release first, since its 'fishc explain' is what gets written`);

  writeFileSync(join(ROOT, "knowledge", "errors.md"), errorsPage(src, at));
  writeFileSync(join(ROOT, "knowledge", "std-api.md"), stdPage(src, at));

  const tmp = mkdtempSync(join(tmpdir(), "fish-sync-"));
  said("sh", ["-c", 'git -C "$1" archive "$2" tests/programs | tar -x -C "$3"', "sh", src, at, tmp]);
  rmSync(join(ROOT, "examples"), { recursive: true, force: true });
  renameSync(join(tmp, "tests", "programs"), join(ROOT, "examples"));
  const programs = readdirSync(join(ROOT, "examples")).length;

  const today = new Date().toISOString().slice(0, 10);
  writeFileSync(join(ROOT, "knowledge", "VERSION"), `fishc: ${release}\nsource: fishlang-dev/fish @ ${at} (${commit})\nsynced: ${today}\n`);
  console.log(`pulled ${at} (${commit}): errors.md, std-api.md, ${programs} entries in examples/`);
}

function report(): void throws IoError {
  const version = join(ROOT, "knowledge", "VERSION");
  const stamped = existsSync(version) ? readFileSync(version, "utf8").match(/^fishc: (\S+)/) : null;
  const pack = stamped === null ? "" : stamped[1]!;
  const have = installed();
  const src = process.env.FISH_SRC ?? resolve(ROOT, "..", "fish");
  const newest = existsSync(join(src, ".git")) ? newestTag(src).slice(1) : "";
  console.log(`pack:      ${pack === "" ? "not stamped" : pack}`);
  console.log(`installed: ${have === "" ? "unknown (fishc isn't a release install on PATH)" : have}`);
  console.log(`source:    ${newest === "" ? `unknown (no checkout at ${src})` : newest}`);
  const drift = pack === "" || (have !== "" && have !== pack) || (newest !== "" && newest !== pack);
  console.log(drift ? "drift: run the sync skill" : "no drift");
  if (drift) process.exit(1);
}

function main(): void throws IoError {
  const args = process.argv.slice(2);
  if (args.length > 0 && args[0]! === "report") report();
  else if (args.length > 0 && args[0]! === "pull") pull(args.length > 1 ? args[1]! : "");
  else fail(USAGE);
}
